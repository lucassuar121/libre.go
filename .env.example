# Copiá este archivo a .env (o definí estas variables en tu servidor / Cloud Run). NUNCA subas el .env real a un repositorio.
# Ninguno de estos valores está escrito en el código.

# ---------- Perfil y base de datos (PRODUCCIÓN) ----------
# prod = PostgreSQL + chequeos de configuración. Sin esta variable la app corre en modo desarrollo (H2 local).
SPRING_PROFILES_ACTIVE=prod
# Ejemplo: jdbc:postgresql://HOST:5432/librego
DB_URL=
DB_USER=
DB_PASSWORD=
# Opcionales: DB_POOL_SIZE=5, DDL_AUTO=update (o none)

# ---------- Mercado Pago ----------
# Access Token de tu aplicación (Mercado Pago > Tus integraciones > tu aplicación > Credenciales)
MERCADOPAGO_ACCESS_TOKEN=
# Public Key de la misma aplicación (hoy no se usa con Checkout Pro, queda reservada)
MERCADOPAGO_PUBLIC_KEY=
# URL pública del webhook: https://TU-DOMINIO/api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_URL=
# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones). Recomendado.
MERCADOPAGO_WEBHOOK_SECRET=
# true solo mientras probás con credenciales de prueba
MERCADOPAGO_SANDBOX=false

# ---------- Tareas automáticas (bajas y vencimientos) ----------
# Secreto para que Cloud Scheduler llame a POST /api/internal/jobs/run (encabezado X-Jobs-Token). Vacío = endpoint deshabilitado.
JOBS_TOKEN=
# Días de gracia antes de eliminar una empresa dada de baja (0 = al vencer el período pagado; se recomienda algunos días)
SUBSCRIPTION_DELETE_GRACE_DAYS=0

# ---------- Suscripción ----------
# Precio mensual en ARS (por defecto 30000)
SUBSCRIPTION_PRICE=30000
# Solo la primera vez: días de acceso gratis para empresas que ya existían antes de la suscripción (0 = quedan pendientes de pago)
SUBSCRIPTION_GRANT_EXISTING_DAYS=0

# ---------- Aplicación ----------
# URL pública de la app (se usa en el email de recuperación y en las URLs de retorno de Mercado Pago)
BASE_URL=http://localhost:8080
# Gmail para enviar facturas y recuperación de contraseña (contraseña de aplicación de Google)
MAIL_USERNAME=
MAIL_PASSWORD=
# Contraseña inicial del administrador global lucas1 (OBLIGATORIA en producción si el usuario aún no existe; mínimo 12 caracteres)
GLOBAL_ADMIN_PASSWORD=
# Aviso por email de nuevas solicitudes de contratación (opcional)
CONTACT_EMAIL=

# ---------- Solo si publicás el frontend en OTRO dominio ----------
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com
# SESSION_COOKIE_SAMESITE=none
